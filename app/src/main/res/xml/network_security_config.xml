<?xml version="1.0" encoding="utf-8"?>
<!-- The MCP server answers plain HTTP on the local network unless TLS is on. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
