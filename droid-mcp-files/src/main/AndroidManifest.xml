<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Write tools on API 28. maxSdkVersion matches the camera/screenshot modules so host
         manifests merge cleanly; a host that wants the write tools on API 29 declares the
         permission up to 29 itself (tools:replace) and sets requestLegacyExternalStorage. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
</manifest>
